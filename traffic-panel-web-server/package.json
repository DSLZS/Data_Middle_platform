{
  "name": "traffic-panel-web-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Traffic panel demo with React + Express + mock data",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "nodemon server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "cf:dev": "npm run build && npx wrangler pages dev dist",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "keywords": [
    "traffic",
    "dashboard",
    "vite",
    "react",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ctrip/imc-icons": "^5.0.48",
    "@tailwindcss/vite": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "vite": "^5.4.10"
  }
}
